# Django Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.railway.app,localhost,127.0.0.1

# Database (Railway will provide DATABASE_URL automatically)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Google Earth Engine
# Option 1: Full JSON string (Recommended for Railway)
GEE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# Option 2: File path (Local/Alternative)
# GEE_KEY_FILE=path/to/key.json
# GEE_SERVICE_ACCOUNT=your-account@project.iam.gserviceaccount.com

# GEE Project ID (Required for newer ee versions)
GEE_PROJECT=your-gee-project-id
